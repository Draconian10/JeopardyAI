# Optional: the public production URL used in confirmation emails when signup occurs on a preview deployment.
# Must be publicly accessible and allowlisted under Supabase Authentication > URL Configuration.
NEXT_PUBLIC_SITE_URL=https://YOUR_PUBLIC_GAME_DOMAIN
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# A random secret of at least 32 characters. Used to hash rate-limit identifiers.
RATE_LIMIT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
