{
  "name": "jeopardy-live",
  "version": "1.0.0",
  "description": "Persistent multiplayer Jeopardy with an authoritative live buzzer",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:live": "node scripts/live-browser.mjs",
    "test:live:fixture": "playwright test --config playwright.live-fixture.config.ts"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
